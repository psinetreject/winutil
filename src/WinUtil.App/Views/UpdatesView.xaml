<UserControl x:Class="WinUtil.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WinUtil.App.Views"
             Background="{DynamicResource MainBackgroundColor}"
             TextElement.Foreground="{DynamicResource MainForegroundColor}">
    <UserControl.Resources>
        <conv:EnumBooleanConverter x:Key="EnumBool" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Windows Update Policy" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />

            <StackPanel>
                <RadioButton GroupName="update" Content="Default (recommended)" Margin="0,4"
                             IsChecked="{Binding SelectedOption, Converter={StaticResource EnumBool}, ConverterParameter=Default}" />
                <TextBlock Text="Restore the default Windows Update behavior."
                           Opacity="0.7" FontSize="11" Margin="22,0,0,6" />

                <RadioButton GroupName="update" Content="Security only" Margin="0,4"
                             IsChecked="{Binding SelectedOption, Converter={StaticResource EnumBool}, ConverterParameter=Security}" />
                <TextBlock Text="Defer feature updates; keep security updates."
                           Opacity="0.7" FontSize="11" Margin="22,0,0,6" />

                <RadioButton GroupName="update" Content="Disable updates" Margin="0,4"
                             IsChecked="{Binding SelectedOption, Converter={StaticResource EnumBool}, ConverterParameter=Disable}" />
                <TextBlock Text="Turn Windows Update off entirely (not recommended)."
                           Opacity="0.7" FontSize="11" Margin="22,0,0,6" />
            </StackPanel>

            <Button Content="Apply" Command="{Binding ApplyCommand}"
                    Padding="16,6" Margin="0,12,0,0" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
