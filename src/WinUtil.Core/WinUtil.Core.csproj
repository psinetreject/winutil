<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Core is platform-agnostic (models + config + abstractions) so it unit-tests on any OS.
         Windows-specific implementations live in WinUtil.Platform. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WinUtil.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions ship in-box with the .NET 10 SDK; verify on `dotnet restore`. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Strict-JSON configs reused verbatim from the PowerShell tool (single source of truth). -->
    <EmbeddedResource Include="..\..\config\applications.json" LogicalName="winutil.applications.json" />
    <EmbeddedResource Include="..\..\config\appx.json" LogicalName="winutil.appx.json" />
    <EmbeddedResource Include="..\..\config\dns.json" LogicalName="winutil.dns.json" />
    <EmbeddedResource Include="..\..\config\preset.json" LogicalName="winutil.preset.json" />
    <EmbeddedResource Include="..\..\config\themes.json" LogicalName="winutil.themes.json" />

    <!-- Ported strict-JSON schemas (generated in M3 from the PS InvokeScript inventory). -->
    <EmbeddedResource Include="..\..\config\tweaks.json" LogicalName="winutil.tweaks.json" />
    <EmbeddedResource Include="..\..\config\features.json" LogicalName="winutil.features.json" />
  </ItemGroup>

</Project>
