<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Versioned Windows TFM enables direct WinRT projections (Windows.Management.Deployment
         for Appx) via the SDK's built-in CsWinRT. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>WinUtil.Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- NOTE: package versions are placeholders — verify/bump on `dotnet restore` (Windows). -->
    <PackageReference Include="Microsoft.Dism" Version="3.2.0" />          <!-- ManagedDism: features, ISO -->
    <PackageReference Include="TaskScheduler" Version="2.11.0" />          <!-- dahall/TaskScheduler -->
    <PackageReference Include="System.Management" Version="10.0.0" />      <!-- WMI: DNS, storage -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unattend answer file baked into the ISO builder (mirrors the PS $WinUtilAutounattendXml). -->
    <EmbeddedResource Include="..\..\config\autounattend.xml" LogicalName="winutil.autounattend.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinUtil.Core\WinUtil.Core.csproj" />
  </ItemGroup>

</Project>
