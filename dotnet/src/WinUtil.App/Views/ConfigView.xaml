<UserControl x:Class="WinUtil.App.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource MainBackgroundColor}"
             TextElement.Foreground="{DynamicResource MainForegroundColor}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">

            <TextBlock Text="DNS" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" />
            <Border Padding="10" CornerRadius="4"
                    Background="{DynamicResource GroupBorderBackgroundColor}">
                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="240" VerticalAlignment="Center"
                              ItemsSource="{Binding DnsOptions}"
                              SelectedItem="{Binding SelectedDns}"
                              DisplayMemberPath="Name" />
                    <Button Content="Apply DNS" Command="{Binding ApplyDnsCommand}"
                            Padding="12,5" Margin="10,0,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="Power" FontSize="15" FontWeight="Bold" Margin="0,16,0,6" />
            <Border Padding="10" CornerRadius="4"
                    Background="{DynamicResource GroupBorderBackgroundColor}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Enable Ultimate Performance"
                            Command="{Binding EnableUltimatePerformanceCommand}"
                            Padding="12,5" Margin="0,0,10,0" />
                    <Button Content="Restore Default Plans"
                            Command="{Binding RestoreDefaultPowerPlansCommand}"
                            Padding="12,5" />
                </StackPanel>
            </Border>

            <TextBlock Text="Fixes" FontSize="15" FontWeight="Bold" Margin="0,16,0,6" />
            <Border Padding="10" CornerRadius="4"
                    Background="{DynamicResource GroupBorderBackgroundColor}">
                <WrapPanel>
                    <Button Content="Reset Network" Command="{Binding FixNetworkCommand}"
                            Padding="12,5" Margin="0,0,8,8" />
                    <Button Content="Reset Windows Update" Command="{Binding FixWindowsUpdateCommand}"
                            Padding="12,5" Margin="0,0,8,8" />
                    <Button Content="Reset Winget Sources" Command="{Binding ResetWingetCommand}"
                            Padding="12,5" Margin="0,0,8,8" />
                    <Button Content="Sync Date/Time (NTP)" Command="{Binding SyncDateTimeCommand}"
                            Padding="12,5" Margin="0,0,8,8" />
                </WrapPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
